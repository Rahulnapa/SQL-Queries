DDL Command:
create table sales (
product_id int,
period_start date,
period_end date,
average_daily_sales int
);

----------------------------------------

insert into sales values(1,'2019-01-25','2019-02-28',100),(2,'2018-12-01','2020-01-01',10),(3,'2019-12-01','2020-01-31',1);

----------------------------------------
Solution:
with r_cte as (
  select min(period_start) min_period,max(period_end) max_period from sales
  union all 
  select dateadd(day,1,min_period) dates,max_period from r_cte 
  where min_period < max_period)
select product_id, year(min_period),sum(average_daily_sales) total_amt from r_cte
inner join sales on min_period between period_start and period_end
group by product_id, year(min_period)
order by product_id, year(min_period)
option(maxrecursion 1000);



