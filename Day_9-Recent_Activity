------------------------------Solution:
with cte as (
select *,count(1) over(partition by username) user_records,
rank() over(partition by username order by  startdate asc) user_number_records
  from UserActivity
)
select username, activity, startdate,enddate from cte where user_number_records = 2 or user_records = 1
