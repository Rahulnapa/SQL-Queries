create table exams
(
exam_id int,
student_id int,
score int);


insert into exams values
(10,1,70),(10,2,80),(10,3,90),(20,1,80),(30,1,70),(30,3,80),(30,4,90),(40,1,60)
,(40,2,70),(40,4,80);

------------------------------------------ Solution

with cte as (
select exam_id,max(score) max_score,min(score) min_score 
from exams
  group by exam_id
)
select student_id
 from exams s 
 inner join cte on cte.exam_id = s.exam_id
 group by student_id
having max(case when score = min_score or score = max_score then 1 else 0 end) = 0


