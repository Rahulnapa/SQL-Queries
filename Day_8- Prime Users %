------------------------------------------ Solution
WITH cte AS (
    SELECT *,
           LEAD(access_date) OVER (
               PARTITION BY user_id
               ORDER BY access_date
           ) AS prime_date
  FROM events
where type in ('Music','P') 

)
SELECT 
(count(distinct case when cast(prime_date as date)-cast(access_date as date) >= 30 then user_id else 0 end) )*1.0/(count(distinct user_id)) percentage_prime
FROM cte
WHERE (prime_date is not null) or (type = 'Music')
