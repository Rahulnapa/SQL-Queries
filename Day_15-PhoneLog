----------------------- SOLUTION
       with cte as (
select callerid,cast(datecalled as date)  call_date,min(datecalled) first_call , max(datecalled) last_call from phonelog
group by callerid,cast(datecalled as date)
 ),
 cte2 as (
 select cte.callerid,call_date,first_call,a.Recipientid first_recipient, 
 b.Recipientid last_recipient 
 from cte
 left join phonelog a on a.Callerid = cte.callerid and a.Datecalled = cte.first_call
  left join phonelog b on b.Callerid = cte.callerid and b.Datecalled = cte.last_call
 )
 select callerid,first_recipient  Recipientid from cte2 
 where first_recipient = last_recipient
