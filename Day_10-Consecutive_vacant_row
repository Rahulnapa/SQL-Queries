-------------------------------------- Solution
with cte as (
select *,LEFT(seat,1) as row_id,cast(SUBSTRING(seat,2,2)as int) as seat_no
from movie),
cte2 as (
select *,row_number() over(order by row_id, seat_no) rn
from cte
where occupancy = 0
),
cte3 as (
select *,abs(seat_no-rn)  diff
from 
cte2
),
cte4 as
(select * ,
count(1) over(partition by row_id,diff) rn2
from cte3)
select seat from cte4 where rn2 = 4

;
